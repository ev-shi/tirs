source("sim.R")
source("assertions_v15.R")
source("utils.R")
library(ggplot2)
library(dplyr)
library(lattice)
# times at which observations were taken
samp_time <- c(1, 3, 5, 8, 10, 14, 17, 20, 26, 35)
# vector of population-level haplotype frequencies
## sums to 1
haplo_freqs <- c(0.6, 0.1, 0.3)
# force of infection for malaria
lambda <- 2.64
# complexity of infection
theta <- 1.7
# rate of haplotype clearance
decay_rate <- 0.5
# sensitivity of sequencing
sens <- 0.99
set.seed(12345)
full1 <- sim_ind(samp_time = samp_time, haplo_freqs = haplo_freqs,
lambda = lambda, theta = theta, decay_rate = decay_rate,
sens = sens, return_full = TRUE)
full1
# sim_cohort <- function(n, samp_time, haplo_freqs, lambda, theta, decay_rate, sens)
cohort10 <- sim_cohort(10, samp_time, haplo_freqs, lambda, theta, decay_rate, sens)
# observed data
cohort10$df_data
# observed states
c10_obs <- lapply(cohort10$raw_list, function(x) x$state_obs)
## individual 1's observed states
c10_obs[[1]]
# true states
c10_true <- lapply(cohort10$raw_list, function(x) x$state_true)
## individual 1's true states
c10_true[[1]]
# heatmap -- by haplotype?
## reformatting the data....yay
### true states for all individuals in the cohort (in a list of lists)
c10_true <- lapply(cohort10$raw_list, function(x) x$state_true)
### matrices for each haplotype
haplo1_mat <- matrix(NA, nrow = 10, ncol = 10)
haplo2_mat <- matrix(NA, nrow = 10, ncol = 10)
haplo3_mat <- matrix(NA, nrow = 10, ncol = 10)
for (i in 1:10) {
indiv <- c10_true[[i]]
haplo1_mat[i, ] <- indiv[, 1]
haplo2_mat[i, ] <- indiv[, 2]
haplo3_mat[i, ] <- indiv[, 3]
}
colnames(haplo1_mat) <- samp_time
colnames(haplo2_mat) <- samp_time
colnames(haplo3_mat) <- samp_time
### plot
library(RColorBrewer)
levelplot(t(haplo1_mat),
xlab = "Observed Timepoints",
ylab = "Individual",
main = "Haplotype 1 Infection Status",
col.regions = colorRampPalette(c("palegreen2", "tomato")),
at = c(-0.5, 0.5, 1.5),
colorkey = list(labels = list(at = c(0, 1),
labels = c("Not Infected",
"Infected"))),
scales = list(y = list(tick.number = nrow(haplo1_mat))))
levelplot(t(haplo2_mat),
xlab = "Observed Timepoints",
ylab = "Individual",
main = "Haplotype 2 Infection Status",
col.regions = colorRampPalette(c("palegreen2", "tomato")),
at = c(-0.5, 0.5, 1.5),
colorkey = list(labels = list(at = c(0, 1),
labels = c("Not Infected",
"Infected"))),
scales = list(y = list(tick.number = nrow(haplo2_mat))))
levelplot(t(haplo3_mat),
xlab = "Observed Timepoints",
ylab = "Individual",
main = "Haplotype 3 Infection Status",
col.regions = colorRampPalette(c("palegreen2", "tomato")),
at = c(-0.5, 0.5, 1.5),
colorkey = list(labels = list(at = c(0, 1),
labels = c("Not Infected",
"Infected"))),
scales = list(y = list(tick.number = nrow(haplo3_mat))))
# density and timing plot
## not sure what the density plots for infection timing are gonna look like so just going to randomly generate something for now
## the true infection times are taken for just one individual?
### just for one bite?
model_x <- c(rnorm(1000, 2.5, 1), rnorm(1000, 6, 0.5))
densityx <- ggplot_build(ggplot(data.frame(time = model_x),
aes(x = time)) +
geom_density(fill = "cadetblue3",
alpha = 0.5))$data[[1]]
y_dens <- approx(densityx$x, densityx$y,xout = full1$t_inf, rule = 2)$y
true_inf <- data.frame(x = full1$t_inf,
yend = y_dens + max(y_dens)*0.25)
ggplot(data.frame(time = model_x), aes(x = time)) +
geom_density(fill = "cadetblue3", alpha = 0.5) +
geom_segment(data = true_inf,
aes(x = x, xend = x, y = 0,
yend = yend),
color = "black", alpha = 0.5) +
labs(title = "Infection Timing Density and True Infection Times",
x = "Time", y = "Density") +
theme_classic() +
scale_x_continuous(breaks = seq(min(samp_time) - 1,
max(samp_time) + 1, by = 1),
limits = c(0, 6))
### all bites?
multimodel_x <- c(rnorm(1000, 2.5, 1),
rnorm(1000, 6, 0.5),
rnorm(1000, 12, 0.5),
rnorm(1000, 18.26, 0.6),
rnorm(1000, 26, 2),
rnorm(1000, 33.79, 2))
densitym <- ggplot_build(ggplot(data.frame(time = multimodel_x),
aes(x = time)) +
geom_density(fill = "cadetblue3",
alpha = 0.5))$data[[1]]
y_densm <- approx(densitym$x, densitym$y, xout = full1$t_inf, rule = 2)$y
tru_inf <- data.frame(x = full1$t_inf,
yend = y_densm + max(y_densm)*0.15)
ggplot(data.frame(time = multimodel_x), aes(x = time)) +
geom_density(fill = "cadetblue3", alpha = 0.5) +
geom_segment(data = tru_inf,
aes(x = x, xend = x, y = 0,
yend = yend),
color = "black", alpha = 0.5) +
labs(title = "Infection Timing Density and True Infection Times",
x = "Time", y = "Density") +
theme_classic() +
scale_x_continuous(breaks = seq(min(samp_time) - 1,
max(samp_time) + 1, by = 1),
limits = c(0, max(full1$t_inf) + 1))
